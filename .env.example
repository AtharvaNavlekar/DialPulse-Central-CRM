# ==============================================================================
# DIALPULSE CENTRAL CRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database Connection URL (Required for migrations & production persistence)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Note: Central CRM operates in standalone mode when unset, but requires this for production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dialpulse_central_crm"

# Authentication & Cryptographic Secrets (Required - minimum 32 characters)
# Fallback secrets in code are strictly disabled. Server will fail to start if unset.
JWT_SECRET="replace-with-ultra-secure-min-32-char-platform-secret-key"
REFRESH_TOKEN_SECRET="replace-with-ultra-secure-min-32-char-refresh-secret-key"

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Optional App URL for OAuth / CORS / Webhooks
APP_URL="http://localhost:3000"

# Seeding Flag (Only set to true if you explicitly want to allow database seeding in production)
ALLOW_PRODUCTION_SEED="false"
