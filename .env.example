# ==============================================================================
# DIALPULSE CENTRAL CRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database Connection URL (Required for migrations & production persistence)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Note: Central CRM operates in standalone mode when unset, but requires this for production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dialpulse_central_crm"

# Authentication & Cryptographic Secrets (Required - minimum 32 characters)
# Fallback secrets in code are strictly disabled. Server will fail to start if unset.
JWT_SECRET="replace-with-ultra-secure-min-32-char-platform-secret-key"
REFRESH_TOKEN_SECRET="replace-with-ultra-secure-min-32-char-refresh-secret-key"

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Optional App URL for OAuth / CORS / Webhooks
APP_URL="http://localhost:3000"

# Standalone Development Authentication Passwords (Only active when NODE_ENV=development and DATABASE_URL is unset)
# Must be distinct, non-empty passwords for each development staff role. Never fall back to defaults.
DEV_ADMIN_PASSWORD="replace-with-local-dev-admin-password"
DEV_SUPPORT_PASSWORD="replace-with-local-dev-support-password"
DEV_SECURITY_PASSWORD="replace-with-local-dev-security-password"

# Database Seeding Bootstrap Passwords (Only active in non-production environments when seeding database)
# Production database seeding is strictly blocked regardless of configuration.
SEED_ADMIN_PASSWORD="replace-with-seed-admin-password"
SEED_SUPPORT_PASSWORD="replace-with-seed-support-password"
SEED_SECURITY_PASSWORD="replace-with-seed-security-password"

