# Stable 32-byte base64 key for encrypting authenticator secrets; store in a secret manager.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
REFRESH_TOKEN_SECRET=
SEED_ADMIN_PASSWORD=
SEED_SECURITY_PASSWORD=
SEED_SUPPORT_PASSWORD=
# Optional trusted PostgreSQL CA bundle (PEM) for production connections.
# Production database TLS always validates certificates; configure PGSSL_CA if your deployment uses a private CA.
# PGSSL_CA=/run/secrets/postgres-ca.pem
